@model IEnumerable<CarRoom.Models.Car>
@{
    ViewData["Title"] = "Quản lý xe";
    var search = ViewBag.Search as string;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Quản lý xe <span class="text-muted fs-6">(@ViewBag.Total xe)</span></h1>
    <a asp-action="Create" class="btn btn-primary">Thêm xe mới</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="search" value="@search" class="form-control" placeholder="Tìm theo hãng hoặc dòng xe"/>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Tìm</button>
        @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="Index" class="btn btn-link">Xóa tìm kiếm</a>
            }
        </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Xe</th>
                <th>Năm</th>
                <th class="text-end">Giá (VNĐ)</th>
                <th>Màu và tồn kho</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
                @foreach (var car in Model)
            {
                var inStock = car.Colors.Any(c => c.SoLuongTon > 0);
                <tr>
                    <td>
                        <div class="fw-semibold">@car.CarModel.Brand.TenHang @car.CarModel.TenDongXe</div>
                        <div class="small text-muted">@car.CarModel.LoaiThanXe, @car.NhienLieu, @car.HopSo</div>
                    </td>
                    <td>@car.NamSanXuat</td>
                    <td class="text-end">@car.Gia.ToString("N0")</td>
                    <td>
                        @foreach (var col in car.Colors)
                        {
                            <form asp-action="Sell" method="post" class="d-flex align-items-center gap-2 mb-1">
                                <input type="hidden" name="colorId" value="@col.Id"/>
                                <input type="hidden" name="returnSearch" value="@search"/>
                                <input type="hidden" name="returnPage" value="@(page)"/>
                                <span class="d-inline-block border rounded-circle" style="width:16px;height:16px;background:@col.MaMauHex"></span>
                                <span class="small">@col.TenMau: <strong>@col.SoLuongTon</strong></span>
                                <button type="submit" class="btn btn-sm btn-outline-success py-0" disabled="@(col.SoLuongTon == 0)">
                                    Bán 1 chiếc
                                </button>
                            </form>
                        }
                    </td>
                    <td>
                        @if (car.TrangThai != "Còn hàng")
                        {
                            <span class="badge text-bg-secondary">Ngừng bán</span>
                        }
                        else if (inStock)
                        {
                            <span class="badge text-bg-success">Còn hàng</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Hết hàng</span>
                        }
                        @if (car.NoiBat=="Có")
                        {
                            <span class="badge text-bg-warning">Nổi bật</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@car.Id" method="post" class="d-inline"
                            onsubmit="return confirm('Xóa xe @car.CarModel.TenDongXe @car.NamSanXuat? Thao tác này không hoàn tác được. ');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Không có xe nào. Bấm "Thêm xe mới" để bắt đầu.</td></tr>
            }
        </tbody>
    </table>
</div>

@if(totalPages > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(page-1)">Trước</a>
            </li>
            @for(int i=1; i<= totalPages; i++)
            {
                <li class="page-item @(i==page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(page == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(page + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}