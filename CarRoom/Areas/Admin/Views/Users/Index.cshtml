@using System.Security.Claims
@using CarRoom.Models
@using CarRoom.Models.ViewModels
@model PagedResult<User>
@{
    string role = ViewBag.Role;
    string? q = ViewBag.Q;
    int me = ViewBag.CurrentUserId;

    string Title(string r) => r == "Staff" ? "nhân viên" : r == "Admin" ? "quản trị viên" : "khách hàng";
    ViewData["Title"] = "Quản lý " + Title(role);
}

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <ul class="nav nav-pills">
        <li class="nav-item">
            <a class="nav-link @(role == "Customer" ? "active" : "")" asp-action="Index" asp-route-role="Customer">Khách hàng</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(role == "Staff" ? "active" : "")" asp-action="Index" asp-route-role="Staff">Nhân viên</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(role == "Admin" ? "active" : "")" asp-action="Index" asp-route-role="Admin">Quản trị viên</a>
        </li>
    </ul>
    <a class="btn btn-primary" asp-action="Create" asp-route-role="@role">+ Thêm @Title(role)</a>
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="role" value="@role" />
    <div class="col-12 col-md-6 col-lg-4">
        <input name="q" value="@q" class="form-control" placeholder="Tìm theo tên hoặc email..." />
    </div>
    <div class="col-auto"><button class="btn btn-outline-light">Tìm</button></div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Tên</th><th>Email</th><th>SĐT</th><th>Trạng thái</th><th>Hành động</th></tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Items)
            {
                bool isMe = u.Id == me;
                <tr>
                    <td>
                        @u.HoTen
                        @if (isMe)
                        {
                            <span class="badge text-bg-info ms-1">Bạn</span>
                        }
                    </td>
                    <td>@u.Email</td>
                    <td>@u.SoDienThoai</td>
                    <td>
                        <span class="badge @(u.TrangThai ? "text-bg-success" : "text-bg-secondary")">
                            @(u.TrangThai ? "Đang hoạt động" : "Đã khóa")
                        </span>
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@u.Id">Sửa</a>

                        @if (!isMe)
                        {
                            <form asp-action="ToggleLock" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-sm @(u.TrangThai ? "btn-warning" : "btn-success")">
                                    @(u.TrangThai ? "Khóa" : "Mở")
                                </button>
                            </form>

                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa tài khoản @u.Email?')">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button class="btn btn-sm btn-danger">Xóa</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">Không có tài khoản nào.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination flex-wrap">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-role="@role" asp-route-q="@q" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}