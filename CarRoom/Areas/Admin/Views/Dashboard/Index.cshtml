
@model CarRoom.Models.ViewModels.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var maxAppointments = Math.Max(1, Model.ThongKeDongXe.Any()
        ? Model.ThongKeDongXe.Max(x => x.SoLichHen)
        : 1);

    var dailyJson = JsonSerializer.Serialize(Model.ThongKe30Ngay.Select(x => new
    {
        label = x.Nhan,
        value = x.SoLichHen
    }));

    var monthlyJson = JsonSerializer.Serialize(Model.ThongKe12Thang.Select(x => new
    {
        label = x.Nhan,
        value = x.SoLichHen
    }));

    var barColors = new[]
    {
        "#4389ff",
        "#39c7a0",
        "#f2a44b",
        "#aa78ef",
        "#f07191",
        "#4bc1df"
    };
}

@section Styles {
    <style>
        .dashboard-page {
            color: #f4f6fb;
        }

        .dashboard-title {
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 22px;
        }

        .dashboard-section-title {
            font-size: 20px;
            font-weight: 650;
            margin: 30px 0 20px;
        }

        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .dashboard-stat-card {
            display: flex;
            align-items: center;
            gap: 18px;
            min-height: 116px;
            padding: 22px;
            background: #272e3c;
            border: 1px solid #465065;
            border-radius: 13px;
        }

        .dashboard-stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            flex-shrink: 0;
            background: #192232;
            border-radius: 12px;
            color: #4389ff;
        }

        .dashboard-stat-icon svg {
            width: 30px;
            height: 30px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .dashboard-stat-label {
            color: #cbd5e1;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .dashboard-stat-value {
            color: #fff;
            font-size: 32px;
            line-height: 1;
            font-weight: 700;
        }

        .dashboard-charts {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
            gap: 20px;
        }

        .dashboard-chart-card {
            min-width: 0;
            min-height: 420px;
            padding: 25px;
            background: linear-gradient(145deg, #292f3e, #222937);
            border: 1px solid #414b5f;
            border-radius: 17px;
            overflow: hidden;
        }

        .dashboard-chart-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 12px;
        }

        .dashboard-chart-title {
            margin: 0;
            color: #f8fafc;
            font-size: 19px;
            font-weight: 650;
        }

        .dashboard-chart-subtitle {
            margin: 0 0 22px;
            color: #9ba9bf;
            font-size: 12px;
        }

        .dashboard-chart-filter {
            min-width: 115px;
            padding: 9px 12px;
            background: #1d2533;
            color: #e5e7eb;
            border: 1px solid #465167;
            border-radius: 9px;
            font-size: 12px;
            cursor: pointer;
        }

        .dashboard-chart-filter:focus {
            outline: none;
            border-color: #5998ff;
        }

        .dashboard-chart-body {
            position: relative;
            width: 100%;
            height: 290px;
        }

        .dashboard-chart-body canvas {
            width: 100% !important;
            height: 100% !important;
        }

        .dashboard-chart-footer {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            color: #b9c6d8;
            font-size: 12px;
        }

        .dashboard-chart-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #4389ff;
        }

        .dashboard-bar-list {
            display: flex;
            flex-direction: column;
            gap: 23px;
            margin-top: 32px;
        }

        .dashboard-bar-item {
            display: grid;
            grid-template-columns: 120px minmax(0, 1fr) 32px;
            gap: 12px;
            align-items: center;
        }

        .dashboard-bar-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #dbe3f0;
            font-size: 12px;
        }

        .dashboard-bar-track {
            height: 21px;
            overflow: hidden;
            border-radius: 6px;
            background: #192130;
        }

        .dashboard-bar-fill {
            height: 100%;
            border-radius: 6px;
            transition: width .6s ease;
        }

        .dashboard-bar-number {
            text-align: right;
            color: #f1f5f9;
            font-size: 13px;
            font-weight: 650;
        }

        .dashboard-empty {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 250px;
            color: #94a3b8;
            text-align: center;
            font-size: 14px;
        }

        .dashboard-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 30px 0;
        }

        .dashboard-summary-item {
            padding: 12px 16px;
            background: #202838;
            border: 1px solid #354157;
            border-radius: 9px;
            font-size: 13px;
            color: #dce4f0;
        }

        .dashboard-summary-item strong {
            margin-left: 10px;
            color: #fff;
        }

        .dashboard-table-card {
            padding: 22px;
            border: 1px solid #414b5f;
            border-radius: 13px;
            background: #272e3c;
        }

        .dashboard-table-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }

        .dashboard-table-heading h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 650;
        }

        .dashboard-table-scroll {
            overflow-x: auto;
        }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
            color: #e5e9f0;
            font-size: 13px;
        }

        .dashboard-table th,
        .dashboard-table td {
            padding: 13px;
            border-bottom: 1px solid #414b5f;
            text-align: left;
            white-space: nowrap;
        }

        .dashboard-table th {
            color: #aeb9ca;
            font-weight: 500;
        }

        .dashboard-status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
        }

        .dashboard-status-pending {
            color: #fde68a;
            background: #574820;
        }

        .dashboard-status-confirmed {
            color: #86efac;
            background: #164e3b;
        }

        .dashboard-status-canceled {
            color: #fca5a5;
            background: #57262d;
        }

        @@media (max-width: 1250px) {
            .dashboard-charts {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 850px) {
            .dashboard-stats {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 550px) {
            .dashboard-chart-card {
                padding: 16px;
                min-height: 365px;
            }

            .dashboard-chart-title {
                font-size: 16px;
            }

            .dashboard-chart-body {
                height: 245px;
            }

            .dashboard-bar-item {
                grid-template-columns: 100px minmax(0, 1fr) 25px;
                gap: 7px;
            }

            .dashboard-stat-value {
                font-size: 27px;
            }
        }
    </style>
}

<div class="dashboard-page">
    <h2 class="dashboard-title">Số liệu tổng quan</h2>

    <div class="dashboard-stats">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M5 17H3v-6l2-5h14l2 5v6h-2" />
                    <path d="M5 17h14M5 17v2h3v-2m8 0v2h3v-2M3 11h18M7 14h2m6 0h2" />
                </svg>
            </div>
            <div>
                <div class="dashboard-stat-label">Tổng số xe</div>
                <div class="dashboard-stat-value">@Model.TongSoXe</div>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M7 3v4m10-4v4M3 10h18M8 14h2m4 0h2m-8 4h2" />
                </svg>
            </div>
            <div>
                <div class="dashboard-stat-label">Số lịch hẹn tháng này</div>
                <div class="dashboard-stat-value">@Model.LichHenThangNay</div>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon">
                <svg viewBox="0 0 24 24">
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6m1 4a5 5 0 0 1 3 5" />
                </svg>
            </div>
            <div>
                <div class="dashboard-stat-label">Tổng người dùng</div>
                <div class="dashboard-stat-value">@Model.TongNguoiDung</div>
            </div>
        </div>
    </div>

    <h3 class="dashboard-section-title">Thống kê hoạt động</h3>

    <div class="dashboard-charts">
        <section class="dashboard-chart-card">
            <div class="dashboard-chart-heading">
                <h4 class="dashboard-chart-title">Lịch hẹn theo thời gian</h4>
                <select id="appointmentFilter"
                        class="dashboard-chart-filter"
                        aria-label="Chọn khoảng thời gian">
                    <option value="7">7 ngày</option>
                    <option value="30" selected>30 ngày</option>
                    <option value="12">12 tháng</option>
                </select>
            </div>

            <p class="dashboard-chart-subtitle">
                Số lịch hẹn được tạo trong khoảng thời gian đã chọn
            </p>

            <div class="dashboard-chart-body">
                <canvas id="appointmentChart"></canvas>
            </div>

            <div class="dashboard-chart-footer">
                <span class="dashboard-chart-dot"></span>
                <span>Số lịch hẹn</span>
            </div>
        </section>

        <section class="dashboard-chart-card">
            <div class="dashboard-chart-heading">
                <h4 class="dashboard-chart-title">
                    Top dòng xe được đặt lịch
                </h4>
            </div>

            <p class="dashboard-chart-subtitle">
                Xếp hạng theo tổng số lịch hẹn
            </p>

            @if (Model.ThongKeDongXe.Any())
            {
                <div class="dashboard-bar-list">
                    @for (var i = 0; i < Model.ThongKeDongXe.Count; i++)
                    {
                        var item = Model.ThongKeDongXe[i];
                        var width = (item.SoLichHen * 100.0 / maxAppointments)
                            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                        var color = barColors[i % barColors.Length];

                        <div class="dashboard-bar-item">
                            <span class="dashboard-bar-name" title="@item.TenDongXe">
                                @item.TenDongXe
                            </span>

                            <div class="dashboard-bar-track">
                                <div class="dashboard-bar-fill"
                                     style="width:@(width)%;background-color:@color"></div>
                            </div>

                            <span class="dashboard-bar-number">
                                @item.SoLichHen
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="dashboard-empty">
                    Chưa có dữ liệu đặt lịch theo dòng xe.
                </div>
            }
        </section>
    </div>

    <div class="dashboard-summary">
        <div class="dashboard-summary-item">
            Tổng lịch hẹn <strong>@Model.TongLichHen</strong>
        </div>

        <div class="dashboard-summary-item">
            Đang chờ <strong>@Model.LichHenDangCho</strong>
        </div>

        <div class="dashboard-summary-item">
            Đã xác nhận <strong>@Model.LichHenDaXacNhan</strong>
        </div>

        <div class="dashboard-summary-item">
            Đã hủy <strong>@Model.LichHenDaHuy</strong>
        </div>
    </div>

    <section class="dashboard-table-card">
        <div class="dashboard-table-heading">
            <h3>Lịch hẹn gần đây</h3>

            <a asp-area="Admin"
               asp-controller="Appointments"
               asp-action="Index"
               class="btn btn-sm btn-outline-light">
                Xem tất cả
            </a>
        </div>

        <div class="dashboard-table-scroll">
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Khách hàng</th>
                        <th>Xe</th>
                        <th>Ngày hẹn</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.LichHenGanDay.Any())
                    {
                        @foreach (var item in Model.LichHenGanDay)
                        {
                            var statusClass = item.TrangThai switch
                            {
                                "Đang chờ" => "dashboard-status-pending",
                                "Đã xác nhận" => "dashboard-status-confirmed",
                                "Đã hủy" => "dashboard-status-canceled",
                                _ => ""
                            };

                            <tr>
                                <td>#@item.Id</td>
                                <td>@item.HoTenKhach</td>
                                <td>@item.TenXe</td>
                                <td>@item.NgayHen.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="dashboard-status @statusClass">
                                        @item.TrangThai
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                Chưa có lịch hẹn nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

    <script>
        (() => {
            const canvas = document.getElementById("appointmentChart");
            const filter = document.getElementById("appointmentFilter");

            if (!canvas || !filter || typeof Chart === "undefined") {
                return;
            }

            const dailyData = @Html.Raw(dailyJson);
            const monthlyData = @Html.Raw(monthlyJson);
            const context = canvas.getContext("2d");

            const gradient = context.createLinearGradient(0, 0, 0, 290);
            gradient.addColorStop(0, "rgba(67, 137, 255, 0.38)");
            gradient.addColorStop(0.55, "rgba(67, 137, 255, 0.12)");
            gradient.addColorStop(1, "rgba(67, 137, 255, 0)");

            function getFilteredData() {
                if (filter.value === "12") {
                    return monthlyData;
                }

                if (filter.value === "7") {
                    return dailyData.slice(-7);
                }

                return dailyData;
            }

            const initialData = getFilteredData();

            const chart = new Chart(context, {
                type: "line",
                data: {
                    labels: initialData.map(x => x.label),
                    datasets: [{
                        label: "Số lịch hẹn",
                        data: initialData.map(x => x.value),
                        borderColor: "#4389ff",
                        backgroundColor: gradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        cubicInterpolationMode: "monotone",
                        pointRadius: 0,
                        pointHoverRadius: 6,
                        pointHoverBackgroundColor: "#4389ff",
                        pointHoverBorderColor: "#ffffff",
                        pointHoverBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    animation: {
                        duration: 750
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: "#151c2b",
                            titleColor: "#ffffff",
                            bodyColor: "#e2e8f0",
                            borderColor: "#445168",
                            borderWidth: 1,
                            padding: 12,
                            displayColors: true
                        }
                    },
                    layout: {
                        padding: {
                            top: 12,
                            right: 8,
                            bottom: 0,
                            left: 0
                        }
                    },
                    scales: {
                        x: {
                            border: {
                                display: false
                            },
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: "#aab8ca",
                                maxRotation: 0,
                                autoSkip: true,
                                maxTicksLimit: 7,
                                font: {
                                    size: 11
                                }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            border: {
                                display: false
                            },
                            grid: {
                                color: "rgba(170, 184, 205, 0.12)",
                                drawTicks: false
                            },
                            ticks: {
                                color: "#aab8ca",
                                precision: 0,
                                padding: 10,
                                maxTicksLimit: 6,
                                font: {
                                    size: 11
                                }
                            }
                        }
                    }
                }
            });

            filter.addEventListener("change", () => {
                const data = getFilteredData();

                chart.data.labels = data.map(x => x.label);
                chart.data.datasets[0].data = data.map(x => x.value);

                chart.update();
            });
        })();
    </script>
}
