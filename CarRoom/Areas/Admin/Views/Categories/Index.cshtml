@using CarRoom.Models
@model List<Brand>
@{
    ViewData["Title"] = "Quản lý danh mục";
    var allBrands = ViewBag.AllBrands as List<Brand> ?? new();
    var models = ViewBag.Models as List<CarModel> ?? new();
    int? selectedId = ViewBag.SelectedBrandId;
    string? q = ViewBag.Q;
}

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success">@TempData["Msg"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">

    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Danh sách hãng xe</h5>
                    <a class="btn btn-primary btn-sm" asp-action="CreateBrand">+ Thêm hãng xe</a>
                </div>

                <form method="get" class="mb-3">
                    <input type="hidden" name="brandId" value="@selectedId" />
                    <input name="q" value="@q" class="form-control" placeholder="Tìm hãng xe..." />
                </form>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Hãng xe</th><th>Số dòng xe</th><th>Hành động</th></tr></thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr class="@(b.Id == selectedId ? "table-active" : "")">
                                    <td>
                                        <a asp-action="Index" asp-route-brandId="@b.Id" asp-route-q="@q"
                                           class="text-decoration-none fw-semibold">@b.TenHang</a>
                                    </td>
                                    <td>@b.CarModels.Count</td>
                                    <td class="text-nowrap">
                                        <a class="btn btn-sm btn-primary" asp-action="EditBrand" asp-route-id="@b.Id">Sửa</a>
                                        <form asp-action="DeleteBrand" method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa hãng @b.TenHang?')">
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <button class="btn btn-sm btn-danger">Xóa</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="3" class="text-center text-secondary py-4">Chưa có hãng xe nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Danh sách dòng xe</h5>
                    @if (allBrands.Any())
                    {
                        <a class="btn btn-primary btn-sm" asp-action="CreateModel" asp-route-brandId="@selectedId">+ Thêm dòng xe</a>
                    }
                </div>

                <form method="get" class="mb-3">
                    <input type="hidden" name="q" value="@q" />
                    <select name="brandId" class="form-select" onchange="this.form.submit()">
                        @foreach (var b in allBrands)
                        {
                            <option value="@b.Id" selected="@(b.Id == selectedId)">@b.TenHang</option>
                        }
                    </select>
                </form>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Dòng xe</th><th>Loại thân xe</th><th>Hành động</th></tr></thead>
                        <tbody>
                            @foreach (var m in models)
                            {
                                <tr>
                                    <td>@m.TenDongXe</td>
                                    <td>@m.LoaiThanXe</td>
                                    <td class="text-nowrap">
                                        <a class="btn btn-sm btn-primary" asp-action="EditModel" asp-route-id="@m.Id">Sửa</a>
                                        <form asp-action="DeleteModel" method="post" class="d-inline"
                                              onsubmit="return confirm('Xóa dòng xe @m.TenDongXe?')">
                                            <input type="hidden" name="id" value="@m.Id" />
                                            <button class="btn btn-sm btn-danger">Xóa</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!models.Any())
                            {
                                <tr><td colspan="3" class="text-center text-secondary py-4">Hãng này chưa có dòng xe nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>