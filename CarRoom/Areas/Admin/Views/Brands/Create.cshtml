
@model CarRoom.Models.Brand

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm hãng xe";
}

<div class="container-fluid px-0">
    <div class="mb-4">
        <h4 class="fw-bold mb-1">Thêm hãng xe mới</h4>
        <p class="text-muted mb-0">
            Nhập thông tin hãng xe cần thêm vào hệ thống
        </p>
    </div>

    <div class="card border-0 rounded-3 p-4" style="max-width: 700px;">
        <form asp-area="Admin"
              asp-controller="Brands"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TenHang" class="form-label fw-semibold">
                    Tên hãng xe
                </label>

                <input asp-for="TenHang"
                       class="form-control"
                       placeholder="Ví dụ: Toyota, BMW, Mercedes-Benz" />

                <span asp-validation-for="TenHang"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Logo" class="form-label fw-semibold">
                    Đường dẫn logo
                </label>

                <input asp-for="Logo"
                       class="form-control"
                       placeholder="Ví dụ: /images/brands/toyota.png" />

                <span asp-validation-for="Logo"
                      class="text-danger small"></span>

                <div class="form-text text-muted">
                    Có thể để trống nếu chưa có logo.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    Lưu hãng xe
                </button>

                <a asp-area="Admin"
                   asp-controller="Brands"
                   asp-action="Index"
                   class="btn btn-outline-light px-4">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>
