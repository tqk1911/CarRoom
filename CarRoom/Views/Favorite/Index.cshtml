
@model IEnumerable<CarRoom.Models.Car>

@{
    ViewData["Title"] = "Xe yêu thích";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">Xe yêu thích</h2>
            <p class="text-muted mb-0">
                Những mẫu xe bạn quan tâm và đã lưu lại
            </p>
        </div>

        <a asp-controller="Cars"
           asp-action="Index"
           class="btn btn-outline-primary rounded-pill px-4">
            Khám phá thêm xe
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center bg-light rounded-4 py-5 px-3">
            <div class="display-3 text-secondary mb-3">♡</div>

            <h4 class="fw-bold">Chưa có xe yêu thích</h4>

            <p class="text-muted">
                Hãy khám phá và lưu những mẫu xe bạn quan tâm.
            </p>

            <a asp-controller="Cars"
               asp-action="Index"
               class="btn btn-primary rounded-pill px-4 mt-2">
                Khám phá xe
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model)
            {
                var image = car.Colors
                    .SelectMany(c => c.CarImages)
                    .OrderByDescending(i => i.LaAnhChinh)
                    .ThenBy(i => i.ThuTu)
                    .FirstOrDefault();

                var imagePath = image?.DuongDanAnh;

                if (!string.IsNullOrWhiteSpace(imagePath))
                {
                    if (!imagePath.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                        && !imagePath.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                        && !imagePath.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
                    {
                        imagePath = Url.Content("~/" + imagePath.TrimStart('~', '/'));
                    }
                }

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <a asp-controller="Cars"
                           asp-action="Detail"
                           asp-route-id="@car.Id"
                           class="text-decoration-none">

                            @if (!string.IsNullOrWhiteSpace(imagePath))
                            {
                                <img src="@imagePath"
                                     alt="@(car.CarModel?.TenDongXe ?? "Xe")"
                                     class="card-img-top"
                                     style="height:230px;object-fit:cover;"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center text-secondary"
                                     style="height:230px;">
                                    Chưa có ảnh
                                </div>
                            }
                        </a>

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="text-muted small mb-2">
                                @(car.CarModel?.Brand?.TenHang ?? "Chưa có hãng xe")
                            </div>

                            <h5 class="card-title fw-bold mb-2">
                                @(car.CarModel?.TenDongXe ?? "Chưa có tên xe")
                            </h5>

                            <h5 class="text-primary fw-bold mb-3">
                                @car.Gia.ToString("N0") VNĐ
                            </h5>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge bg-light text-dark border">
                                    @car.NamSanXuat
                                </span>

                                <span class="badge bg-light text-dark border">
                                    @car.HopSo
                                </span>

                                <span class="badge bg-light text-dark border">
                                    @car.NhienLieu
                                </span>
                            </div>

                            <div class="mb-4">
                                <span class="badge @(car.ConHang ? "bg-success" : "bg-secondary")">
                                    @car.TrangThai
                                </span>
                            </div>

                            <div class="mt-auto">
                                <a asp-controller="Cars"
                                   asp-action="Detail"
                                   asp-route-id="@car.Id"
                                   class="btn btn-primary w-100 rounded-pill mb-2">
                                    Xem chi tiết
                                </a>

                                <form asp-controller="Favorite"
                                      asp-action="Remove"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="carId"
                                           value="@car.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger w-100 rounded-pill">
                                        ♡ Bỏ yêu thích
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
