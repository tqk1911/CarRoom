
@model IEnumerable<CarRoom.Models.Car>

@{
    ViewData["Title"] = "Xe yêu thích";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1">Xe yêu thích</h2>
            <p class="text-muted mb-0">
                Danh sách những mẫu xe bạn đã lưu
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>
            Trang chủ
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center bg-light rounded-4 py-5 px-3">
            <i class="bi bi-heart text-secondary display-3"></i>

            <h4 class="fw-bold mt-3">
                Chưa có xe yêu thích
            </h4>

            <p class="text-muted">
                Hãy khám phá và lưu những mẫu xe bạn quan tâm.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary rounded-pill px-4 mt-2">
                Khám phá xe
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <div class="bg-light text-center py-5">
                            <i class="bi bi-car-front-fill text-secondary display-2"></i>
                        </div>

                        <div class="card-body p-4">
                            <div class="text-muted small mb-2">
                                @(car.CarModel?.Brand?.TenHang ?? "Chưa có hãng xe")
                            </div>

                            <h5 class="card-title fw-bold mb-3">
                                @(car.CarModel?.TenDongXe ?? "Chưa có tên xe")
                            </h5>

                            <h5 class="text-primary fw-bold mb-3">
                                @car.Gia.ToString("N0") VNĐ
                            </h5>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge bg-light text-dark border">
                                    @car.NamSanXuat
                                </span>

                                <span class="badge bg-light text-dark border">
                                    @car.HopSo
                                </span>

                                <span class="badge bg-light text-dark border">
                                    @car.NhienLieu
                                </span>
                            </div>

                            <div class="mb-3">
                                <span class="badge bg-secondary">
                                    @car.TrangThai
                                </span>
                            </div>

                            <form asp-controller="Favorite"
                                  asp-action="Remove"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="carId"
                                       value="@car.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger w-100 rounded-pill">
                                    <i class="bi bi-heartbreak me-1"></i>
                                    Bỏ yêu thích
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
