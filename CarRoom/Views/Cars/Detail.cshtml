
@model CarRoom.Models.ViewModels.CarDetailViewModel
@using CarRoom.Models
@using CarRoom.Models.ViewModels

@{
    var car = Model.Car;
    var title = $"{car.CarModel.Brand.TenHang} {car.CarModel.TenDongXe} {car.NamSanXuat}";
    ViewData["Title"] = title;

    var colors = car.Colors.OrderBy(c => c.Id).ToList();
    var inStock = colors.Any(c => c.SoLuongTon > 0);
    var activeColor = colors.FirstOrDefault(c => c.SoLuongTon > 0) ?? colors.FirstOrDefault();

    const string placeholder = "data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='900' height='600'%3E%3Crect width='100%25' height='100%25' fill='%23e9ecef'/%3E%3Ctext x='50%25' y='50%25' fill='%236c757d' font-family='sans-serif' font-size='36' text-anchor='middle' dominant-baseline='middle'%3EChưa có ảnh%3C/text%3E%3C/svg%3E";
    string MainImage(Car c) => c.Colors.SelectMany(x => x.CarImages).OrderByDescending(i => i.LaAnhChinh).ThenBy(i => i.ThuTu).Select(i => i.DuongDanAnh).FirstOrDefault() ?? placeholder;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cars" asp-action="Index">Danh sách xe</a></li>
            <li class="breadcrumb-item active" aria-current="page">@car.CarModel.TenDongXe</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-7">
            @foreach (var col in colors)
            {
                var images = col.CarImages.OrderBy(i => i.ThuTu).ToList();
                var isActive = activeColor != null && col.Id == activeColor.Id;

                <div class="color-gallery @(isActive ? "" : "d-none")" data-color-id="@col.Id">
                    @if (images.Count == 0)
                    {
                        <img src="@placeholder" class="d-block w-100 rounded" alt="Chưa có ảnh màu @col.TenMau" />
                    }
                    else
                    {
                        <div id="carousel-@col.Id" class="carousel slide" data-bs-ride="false">
                            @if (images.Count > 1)
                            {
                                <div class="carousel-indicators">
                                    @for (int i = 0; i < images.Count; i++)
                                    {
                                        <button type="button"
                                                data-bs-target="#carousel-@col.Id"
                                                data-bs-slide-to="@i"
                                                class="@(i == 0 ? "active" : "")"
                                                aria-label="Ảnh @(i + 1)">
                                        </button>
                                    }
                                </div>
                            }

                            <div class="carousel-inner rounded">
                                @for (int i = 0; i < images.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@images[i].DuongDanAnh"
                                             class="d-block w-100"
                                             style="aspect-ratio:3/2;object-fit:cover"
                                             alt="@title màu @col.TenMau, ảnh @(i + 1)" />
                                    </div>
                                }
                            </div>

                            @if (images.Count > 1)
                            {
                                <button class="carousel-control-prev"
                                        type="button"
                                        data-bs-target="#carousel-@col.Id"
                                        data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Ảnh trước</span>
                                </button>

                                <button class="carousel-control-next"
                                        type="button"
                                        data-bs-target="#carousel-@col.Id"
                                        data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Ảnh sau</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @if (colors.Count == 0)
            {
                <img src="@placeholder" class="d-block w-100 rounded" alt="Chưa có ảnh" />
            }
        </div>

        <div class="col-lg-5">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <h1 class="h3">@title</h1>

                @if (inStock)
                {
                    <span class="badge text-bg-success">Còn hàng</span>
                }
                else
                {
                    <span class="badge text-bg-danger">Hết hàng</span>
                }
            </div>

            <div class="fs-3 fw-bold text-primary mb-3">
                @car.Gia.ToString("N0") đ
            </div>

            @if (colors.Count > 0)
            {
                <div class="mb-3">
                    <div class="form-label">
                        Màu xe: <strong id="color-name">@activeColor?.TenMau</strong>
                        <span id="color-stock" class="small text-muted"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2"
                         role="radiogroup"
                         aria-label="Chọn màu xe">
                        @foreach (var col in colors)
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary color-pick d-flex align-items-center gap-2 @(activeColor != null && col.Id == activeColor.Id ? "active" : "")"
                                    data-color-id="@col.Id"
                                    data-color-name="@col.TenMau"
                                    data-stock="@col.SoLuongTon"
                                    role="radio"
                                    aria-checked="@(activeColor != null && col.Id == activeColor.Id ? "true" : "false")">
                                <span class="d-inline-block border rounded-circle"
                                      style="width:18px;height:18px;background:@col.MaMauHex"></span>
                                @col.TenMau
                            </button>
                        }
                    </div>
                </div>
            }

            <table class="table table-sm mb-3">
                <caption class="visually-hidden">Thông số xe</caption>
                <tbody>
                    <tr><th scope="row" class="w-50 fw-normal text-muted">Hãng</th><td>@car.CarModel.Brand.TenHang</td></tr>
                    <tr><th scope="row" class="fw-normal text-muted">Dòng xe</th><td>@car.CarModel.TenDongXe</td></tr>
                    <tr><th scope="row" class="fw-normal text-muted">Loại thân xe</th><td>@car.CarModel.LoaiThanXe</td></tr>
                    <tr><th scope="row" class="fw-normal text-muted">Năm sản xuất</th><td>@car.NamSanXuat</td></tr>
                    <tr><th scope="row" class="fw-normal text-muted">Hộp số</th><td>@car.HopSo</td></tr>
                    <tr><th scope="row" class="fw-normal text-muted">Nhiên liệu</th><td>@car.NhienLieu</td></tr>
                </tbody>
            </table>

            <a href="#dat-lich" class="btn btn-primary w-100">
                Đặt lịch xem xe
            </a>

            <button type="button"
                    id="detail-favorite-button"
                    class="btn btn-outline-danger w-100 mt-2"
                    data-car-id="@car.Id"
                    aria-pressed="false"
                    disabled>
                ♡ Yêu thích
            </button>

            <div id="detail-favorite-message"
                 class="small mt-2 d-none"
                 role="status"
                 aria-live="polite">
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(car.MoTa))
    {
        <section class="mt-5">
            <h2 class="h4">Mô tả</h2>
            <div>@Html.Raw(car.MoTa)</div>
        </section>
    }

    <section id="dat-lich" class="mt-5">
        <h2 class="h4">Đặt lịch xem xe</h2>
        <partial name="_AppointmentForm" model="new AppointmentFormViewModel { CarId = car.Id }" />
    </section>

    @if (Model.SimilarCars.Count > 0)
    {
        <section class="mt-5">
            <h2 class="h4 mb-3">Xe tương tự</h2>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                @foreach (var s in Model.SimilarCars)
                {
                    var sName = $"{s.CarModel.Brand.TenHang} {s.CarModel.TenDongXe}";
                    var sInStock = s.Colors.Any(c => c.SoLuongTon > 0);

                    <div class="col">
                        <div class="card h-100">
                            <img src="@MainImage(s)"
                                 class="card-img-top"
                                 alt="@sName"
                                 style="aspect-ratio:3/2;object-fit:cover"
                                 loading="lazy" />

                            <div class="card-body d-flex flex-column">
                                <h3 class="h6 card-title">
                                    <a asp-action="Detail"
                                       asp-route-id="@s.Id"
                                       class="text-decoration-none text-reset stretched-link">
                                        @sName
                                    </a>
                                </h3>

                                <div class="smaill text-muted mb-2">
                                    @s.NamSanXuat, @s.NhienLieu @(sInStock ? "" : "(hết hàng)")
                                </div>

                                <div class="fw-bold text-primary mt-auto">
                                    @s.Gia.ToString("N0") đ
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var buttons = document.querySelectorAll('.color-pick');
            var galleries = document.querySelectorAll('.color-gallery');
            var nameEl = document.getElementById('color-name');
            var stockEl = document.getElementById('color-stock');

            function show(btn) {
                buttons.forEach(function (b) {
                    var on = b === btn;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-checked', on ? 'true' : 'false');
                });

                galleries.forEach(function (g) {
                    g.classList.toggle('d-none', g.dataset.colorId !== btn.dataset.colorId);
                });

                nameEl.textContent = btn.dataset.colorName;

                var stock = parseInt(btn.dataset.stock, 10);

                stockEl.textContent = stock > 0
                    ? '(còn ' + stock + ' xe)'
                    : '(hết hàng màu này)';
            }

            buttons.forEach(function (b) {
                b.addEventListener('click', function () {
                    show(b);
                });
            });

            var first = document.querySelector('.color-pick.active');

            if (first) {
                show(first);
            }
        })();

        (function () {
            var button = document.getElementById('detail-favorite-button');
            var message = document.getElementById('detail-favorite-message');

            if (!button) {
                return;
            }

            var carId = parseInt(button.dataset.carId, 10);
            var token = document.querySelector('input[name="__RequestVerificationToken"]');

            function setFavorite(isFavorite) {
                button.classList.toggle('btn-danger', isFavorite);
                button.classList.toggle('btn-outline-danger', !isFavorite);
                button.textContent = isFavorite
                    ? '♥ Đã yêu thích'
                    : '♡ Yêu thích';
                button.setAttribute('aria-pressed', isFavorite ? 'true' : 'false');
            }

            function showMessage(text, isError) {
                message.textContent = text;
                message.classList.remove('d-none', 'text-success', 'text-danger');
                message.classList.add(isError ? 'text-danger' : 'text-success');
            }

            fetch('@Url.Action("Status", "Favorite")', {
                credentials: 'same-origin'
            })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('Không thể tải trạng thái yêu thích.');
                }

                return response.json();
            })
            .then(function (data) {
                var ids = Array.isArray(data.carIds) ? data.carIds : [];
                setFavorite(ids.some(function (id) {
                    return Number(id) === carId;
                }));
                button.disabled = false;
            })
            .catch(function () {
                showMessage('Không tải được trạng thái yêu thích.', true);
            });

            button.addEventListener('click', function () {
                if (!token) {
                    showMessage('Không tìm thấy mã xác thực. Vui lòng tải lại trang.', true);
                    return;
                }

                button.disabled = true;
                message.classList.add('d-none');

                var body = new URLSearchParams();
                body.append('carId', String(carId));
                body.append('__RequestVerificationToken', token.value);

                fetch('@Url.Action("ToggleAjax", "Favorite")', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
                    },
                    body: body.toString()
                })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Không cập nhật được danh sách yêu thích.');
                    }

                    return response.json();
                })
                .then(function (data) {
                    if (!data.success) {
                        throw new Error(data.message || 'Có lỗi xảy ra.');
                    }

                    setFavorite(data.isFavorite);
                    showMessage(data.message, false);
                })
                .catch(function (error) {
                    showMessage(error.message, true);
                })
                .finally(function () {
                    button.disabled = false;
                });
            });
        })();
    </script>
}
