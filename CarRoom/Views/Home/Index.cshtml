@model IEnumerable<CarRoom.Models.Car>
@{
    ViewData["Title"] = "Trang chủ - Car Showroom";
}

<!-- 1. HERO BANNER -->
<section class="py-5 bg-dark text-white position-relative" style="background: linear-gradient(135deg, #11141c 0%, #1e2433 100%); min-height: 480px;">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <span class="text-uppercase tracking-wider text-secondary small fw-semibold">Chào mừng đến với Car Showroom</span>
                <h1 class="display-5 fw-bold mt-2 mb-4 text-white">KHÁM PHÁ SỰ HOÀN HẢO.</h1>
                <p class="text-secondary mb-4 fs-6">Showroom xe ô tô thế hệ mới. Đa dạng mẫu mã, công nghệ vượt trội và dịch vụ tư vấn hàng đầu.</p>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-light px-4 py-2 fw-semibold rounded-pill shadow">
                    Xem Dòng Xe Mới Nhất
                </a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1000&q=80" 
                     alt="Mercedes EQS Showroom" class="img-fluid rounded-4 shadow-lg" style="max-height: 360px; object-fit: contain;" />
            </div>
        </div>
    </div>
</section>

<!-- 2. BỘ SƯU TẬP (BODY TYPES) -->
<section class="py-5 bg-white">
    <div class="container">
        <h4 class="fw-bold mb-4 text-dark">Bộ sưu tập</h4>
        <div class="row g-4">
            <div class="col-md-4">
                <a asp-controller="Cars" asp-action="Index" asp-route-bodyType="SUV" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <img src="https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&w=600&q=80" 
                             class="card-img-top" style="height: 180px; object-fit: cover;" alt="SUV" />
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill fs-6">SUV</span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a asp-controller="Cars" asp-action="Index" asp-route-bodyType="Sedan" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <img src="https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=600&q=80" 
                             class="card-img-top" style="height: 180px; object-fit: cover;" alt="Sedan" />
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill fs-6">Sedan</span>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a asp-controller="Cars" asp-action="Index" asp-route-fuel="Điện" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                        <img src="https://images.unsplash.com/photo-1560958089-b8a1929cea89?auto=format&fit=crop&w=600&q=80" 
                             class="card-img-top" style="height: 180px; object-fit: cover;" alt="Xe Điện" />
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill fs-6">Xe Điện</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- 3. DANH SÁCH XE MỚI VỀ -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0 text-dark">Xe mới về</h4>
            <a asp-controller="Cars" asp-action="Index" class="text-decoration-none fw-semibold text-primary">Xem tất cả &rarr;</a>
        </div>
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var car in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                            <div class="position-relative">
                                <img src="https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=600&q=80" 
                                     class="card-img-top" alt="@car.CarModel?.TenDongXe" 
                                     style="height: 200px; object-fit: cover;" />
                                <span class="badge bg-primary position-absolute top-0 start-0 m-2 px-2 py-1 rounded">NEW</span>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <small class="text-muted">@(car.CarModel?.Brand?.TenHang ?? "Hãng xe")</small>
                                    <h6 class="fw-bold text-dark mt-1 mb-2 text-truncate">
                                        <a asp-controller="Cars" asp-action="Detail" asp-route-id="@car.Id" class="text-decoration-none text-dark">
                                            @(car.CarModel?.TenDongXe ?? "Dòng xe")
                                        </a>
                                    </h6>
                                    <div class="fw-bold text-danger fs-5 mb-2">
                                        @car.Gia.ToString("#,##0") VND
                                    </div>
                                    <div class="small text-secondary mb-3">
                                        <span>@car.NamSanXuat</span> • 
                                        <span>@car.HopSo</span> • 
                                        <span>@car.NhienLieu</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Cars" asp-action="Detail" asp-route-id="@car.Id" class="btn btn-outline-dark btn-sm w-100 rounded-pill">
                                        Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 text-muted">
                    <p>Hiện chưa có xe mới đăng tải.</p>
                </div>
            }
        </div>
    </div>
</section>