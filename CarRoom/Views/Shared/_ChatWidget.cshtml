<button id="chat-bubble" class="btn btn-primary rounded-circle shadow position-fixed"
        style="bottom:20px; right:20px; width:56px; height:56px; z-index:1050">
    💬
</button>

<div id="chat-box" class="card shadow position-fixed d-none"
     style="bottom:88px; right:20px; width:320px; max-width:calc(100vw - 40px); height:420px; z-index:1050">
    <div class="card-header d-flex justify-content-between align-items-center text-white" style="background:#16233f">
        <span>Tư vấn viên Showroom</span>
        <button id="chat-close" class="btn-close btn-close-white"></button>
    </div>
    <div id="chat-messages" class="card-body overflow-auto d-flex flex-column gap-2 bg-light"></div>
    <div class="card-footer d-flex gap-2">
        <input id="chat-input" class="form-control form-control-sm" placeholder="Nhập câu hỏi..." />
        <button id="chat-send" class="btn btn-primary btn-sm">Gửi</button>
    </div>
</div>